# Optional: DEEPSEEK_API_KEY overrides only the built-in DeepSeek key.
# Custom compatible endpoints and separate text/vision keys are configured in App Settings.
# This file is a reference; the launcher does not automatically load .env.
# DEEPSEEK_API_KEY=your-key
# STUDY_ACCESS_CODE=choose-at-least-8-characters
# STUDY_DATA_DIR=/absolute/path/to/private-data
# STUDY_PORT=8000
# STUDY_MAX_PDF_MB=1024
# STUDY_MAX_PDF_PAGES=2000
